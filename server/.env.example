# Copy this file to ".env" and fill in your token.
# On a host (Render/Railway/Vercel) set these as Environment Variables instead.

# X (Twitter) API v2 Bearer token — from your X developer app (Basic tier or higher).
X_BEARER_TOKEN=

# Currency symbol shown on money values (default R for South African Rand).
CURRENCY_SYMBOL=R

# Port (most hosts set this automatically; leave blank locally to use 8787).
PORT=
