# Copy this file to ".env" and fill in your tokens.
# On a host (Render/Railway/Vercel) set these as Environment Variables instead.

# --- X (Twitter) ---
# X API v2 Bearer token (from your X developer app). Reading analytics is pay-per-use.
X_BEARER_TOKEN=

# --- Meta (Instagram + Facebook + Ads) — FREE API ---
# Long-lived Meta Graph API access token (Page / System User token).
META_TOKEN=
# Optional: set these only if you manage several Meta clients and want to be explicit.
# Otherwise they're auto-discovered from the token. (Per-client IDs can also be set
# in the dashboard's "Add Client" form under Advanced.)
META_PAGE_ID=
META_IG_USER_ID=
META_AD_ACCOUNT_ID=

# --- TikTok — FREE API ---
# Per-account OAuth access token (each client authorises once). You can also set
# the token per-client in the dashboard. Optional ad spend needs the Business API.
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=
TIKTOK_BUSINESS_TOKEN=

# --- LinkedIn — FREE API (needs Marketing Developer Platform approval) ---
LINKEDIN_TOKEN=
LINKEDIN_ORG_ID=
LINKEDIN_VERSION=202401

# --- General ---
# Currency symbol on money values (default R for South African Rand).
CURRENCY_SYMBOL=R
# How often each platform is actually polled (hours). 12 = ~2 polls/day per account.
# This is the knob that keeps X (pay-per-use) cheap no matter how often the
# dashboard refreshes. 24 = ~1 poll/day (cheapest).
CACHE_TTL_HOURS=12
# Port (most hosts set this automatically; blank = 8787 locally).
PORT=
